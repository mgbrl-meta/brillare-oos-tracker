/* =========================================================
   CEO x Figma Mobile Command Table Upgrade
   Compact mobile table, no boring cards.
   Applies under 768px only.
   ========================================================= */

.executiveStrip {
  display: none;
}

@media (max-width: 767px) {
  .executiveStrip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: -2px 0 14px;
  }

  .executiveStrip > div {
    border: 1px solid var(--line);
    background: var(--surface);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: var(--shadow2);
    border-radius: 18px;
    padding: 10px 9px;
    min-width: 0;
  }

  .executiveStrip span {
    display: block;
    color: var(--soft);
    font-size: 9px;
    line-height: 1.1;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .executiveStrip strong {
    display: block;
    margin-top: 6px;
    color: var(--ink);
    font-size: 14px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .products .mobileList,
  .mobileList {
    display: none !important;
  }

  .mobileTableHint {
    display: block;
    margin: 10px 2px 0;
    color: var(--soft);
    font-size: 11.5px;
    line-height: 1.35;
  }

  .mobileCommandTable,
  .desktopTableCard.mobileCommandTable {
    display: block !important;
    width: calc(100vw - 28px);
    max-width: calc(100vw - 28px);
    overflow-x: auto;
    overflow-y: hidden;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow2);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .mobileCommandTable table {
    width: max-content;
    min-width: 900px;
    border-collapse: separate;
    border-spacing: 0;
  }

  .mobileCommandTable th,
  .mobileCommandTable td {
    padding: 11px 10px;
    font-size: 12px;
    white-space: nowrap;
    vertical-align: middle;
  }

  .mobileCommandTable th {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .mobileCommandTable th:first-child,
  .mobileCommandTable td:first-child {
    position: sticky;
    left: 0;
    z-index: 6;
    width: 190px;
    min-width: 190px;
    max-width: 190px;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 10px 0 22px rgba(0, 0, 0, 0.1);
  }

  .mobileCommandTable th:first-child {
    z-index: 8;
  }

  html[data-theme="dark"] .mobileCommandTable th:first-child,
  html[data-theme="dark"] .mobileCommandTable td:first-child,
  html[data-theme="dark"] .mobileCommandTable th {
    background: rgba(17, 20, 18, 0.92);
  }

  .mobileCommandTable .productName {
    max-width: 170px;
    font-size: 12.5px;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    white-space: normal;
    overflow: hidden;
  }

  .mobileCommandTable .sku {
    margin-top: 3px;
    font-size: 10.5px;
  }

  .mobileCommandTable th:nth-child(2),
  .mobileCommandTable td:nth-child(2) {
    display: none;
  }

  .mobileCommandTable th:not(:first-child),
  .mobileCommandTable td:not(:first-child) {
    text-align: center;
    min-width: 72px;
  }

  .mobileCommandTable th:last-child,
  .mobileCommandTable td:last-child {
    min-width: 96px;
  }

  .mobileCommandTable .statusCell {
    justify-content: center;
    min-height: 30px;
    gap: 4px;
  }

  .mobileCommandTable .statusDot {
    width: 11px;
    height: 11px;
  }

  .mobileCommandTable .statusDot.good {
    box-shadow: 0 0 0 5px rgba(31, 157, 107, 0.13);
  }

  .mobileCommandTable .statusDot.bad {
    box-shadow: 0 0 0 5px rgba(224, 86, 79, 0.13);
  }

  .mobileCommandTable .tinyDanger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: rgba(224, 86, 79, 0.14);
    color: var(--bad);
    font-size: 10px;
    font-weight: 900;
  }

  .mobileCommandTable .priceRiskCell {
    background: rgba(224, 86, 79, 0.1);
  }

  .mobileCommandTable .badgeStack {
    justify-content: center;
    gap: 4px;
  }

  .mobileCommandTable .pill {
    min-height: 23px;
    padding: 0 8px;
    font-size: 10.5px;
  }

  .mobileCommandTable tr:has(.pill.bad) td:first-child {
    box-shadow:
      inset 3px 0 0 var(--bad),
      10px 0 22px rgba(0, 0, 0, 0.1);
  }

  .mobileCommandTable tbody tr {
    transition: background 160ms ease;
  }

  .mobileCommandTable tbody tr:active {
    background: var(--surface2);
  }

  .controls {
    top: 64px;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .searchWrap {
    grid-column: 1 / -1;
  }

  .searchWrap,
  .selectWrap {
    min-height: 44px;
    border-radius: 16px;
    padding-inline: 12px;
  }

  .searchWrap input,
  .selectWrap select {
    font-size: 13px;
  }

  .legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
    margin-top: 12px;
    font-size: 11.5px;
  }

  .kpiGrid {
    display: none;
  }

  .section {
    margin-top: 18px;
  }

  .sectionTitle {
    margin-bottom: 12px;
  }

  .sectionTitle h2 {
    font-size: 24px;
  }

  .sectionTitle p {
    font-size: 13px;
  }

  .primaryButton {
    min-height: 42px;
    border-radius: 16px;
  }
}

@media (max-width: 390px) {
  .executiveStrip {
    grid-template-columns: 1fr;
  }

  .executiveStrip > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .executiveStrip strong {
    margin-top: 0;
  }

  .mobileCommandTable th:first-child,
  .mobileCommandTable td:first-child {
    width: 168px;
    min-width: 168px;
    max-width: 168px;
  }

  .mobileCommandTable .productName {
    max-width: 148px;
  }
}

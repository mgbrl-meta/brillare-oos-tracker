:root {
  --bg: #20211f;
  --bg-soft: #242522;
  --panel: rgba(45, 46, 42, 0.92);
  --panel-2: rgba(55, 56, 51, 0.88);
  --panel-3: rgba(35, 36, 33, 0.9);
  --line: rgba(255, 255, 255, 0.1);
  --line-strong: rgba(255, 255, 255, 0.18);
  --text: #f6f1e8;
  --muted: #aaa59a;
  --muted-2: #7f7a70;
  --green: #17a77d;
  --green-soft: rgba(23, 167, 125, 0.12);
  --red: #f25555;
  --red-soft: rgba(242, 85, 85, 0.12);
  --amber: #dc9222;
  --amber-soft: rgba(220, 146, 34, 0.13);
  --cream: #f5ead7;
  --shadow: 0 22px 60px rgba(0, 0, 0, 0.26);
  --shadow-soft: 0 12px 30px rgba(0, 0, 0, 0.16);
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  background:
    radial-gradient(circle at top left, rgba(245, 234, 215, 0.07), transparent 34%),
    radial-gradient(circle at top right, rgba(23, 167, 125, 0.09), transparent 32%),
    var(--bg);
  color: var(--text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", sans-serif;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.page {
  min-height: 100vh;
  padding: 30px;
  max-width: 1240px;
  margin: 0 auto;
}

.hero {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 22px;
  align-items: start;
  margin-bottom: 22px;
}

.eyebrow {
  color: var(--muted);
  font-size: 13px;
  letter-spacing: 0.02em;
  margin-bottom: 9px;
}

h1 {
  margin: 0;
  font-size: 38px;
  line-height: 1;
  letter-spacing: -0.055em;
}

.subtitle {
  color: var(--muted);
  margin: 12px 0 0;
  max-width: 760px;
  line-height: 1.55;
  font-size: 15px;
}

.lastUpdated {
  min-width: 250px;
  border: 1px solid var(--line);
  background: linear-gradient(145deg, rgba(55, 56, 51, 0.92), rgba(36, 37, 34, 0.92));
  border-radius: 20px;
  padding: 16px;
  box-shadow: var(--shadow-soft);
}

.lastUpdatedLabel {
  color: var(--muted);
  font-size: 12px;
}

.lastUpdatedValue {
  color: var(--text);
  font-weight: 800;
  margin-top: 6px;
  font-size: 14px;
}

.tabShell {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 10px 0 18px;
  backdrop-filter: blur(18px);
}

.tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  padding: 7px;
  border: 1px solid var(--line);
  background: rgba(34, 35, 32, 0.78);
  border-radius: 18px;
  box-shadow: var(--shadow-soft);
}

.tab {
  border: 0;
  color: var(--muted);
  background: transparent;
  border-radius: 13px;
  padding: 13px 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  font-weight: 750;
  transition: 0.18s ease;
}

.tab:hover {
  color: var(--cream);
  background: rgba(255, 255, 255, 0.045);
}

.tab.active {
  color: #201f1d;
  background: var(--cream);
  box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
}

.kpiGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}

.card {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line);
  background: linear-gradient(145deg, var(--panel), rgba(36, 37, 34, 0.92));
  border-radius: 22px;
  padding: 18px;
  box-shadow: var(--shadow-soft);
}

.card::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(135deg, rgba(255,255,255,0.055), transparent 36%);
}

.cardHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 14px;
}

.cardTitle {
  color: var(--cream);
  font-size: 15px;
  font-weight: 850;
  letter-spacing: -0.02em;
}

.cardHint {
  color: var(--muted);
  font-size: 12px;
}

.kpiLabel {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 9px;
}

.kpiValue {
  font-size: 32px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: -0.055em;
}

.kpiSub {
  color: var(--muted);
  font-size: 12px;
  margin-top: 8px;
}

.green {
  color: var(--green);
}

.red {
  color: var(--red);
}

.amber {
  color: var(--amber);
}

.section {
  margin-top: 24px;
}

.sectionTitle {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  margin: 0 0 12px;
}

.sectionTitle h2 {
  margin: 0;
  font-size: 19px;
  letter-spacing: -0.03em;
}

.sectionTitle p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.platformGrid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 11px;
}

.platformCard {
  border: 1px solid var(--line-strong);
  background: linear-gradient(145deg, rgba(63, 64, 59, 0.86), rgba(42, 43, 39, 0.9));
  border-radius: 17px;
  padding: 15px;
  box-shadow: var(--shadow-soft);
}

.platformName {
  color: var(--cream);
  font-weight: 850;
  font-size: 13px;
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 13px;
}

.platformNum {
  font-size: 23px;
  font-weight: 950;
  color: var(--green);
  letter-spacing: -0.04em;
}

.platformNum span {
  color: var(--muted);
  font-size: 14px;
  font-weight: 600;
}

.bar {
  height: 5px;
  background: rgba(0,0,0,0.32);
  border-radius: 99px;
  overflow: hidden;
  margin-top: 13px;
}

.barFill {
  height: 100%;
  background: linear-gradient(90deg, var(--green), #33c79e);
  border-radius: 99px;
}

.controls {
  display: grid;
  grid-template-columns: 1.3fr 0.8fr 0.8fr auto;
  gap: 10px;
  margin-bottom: 14px;
}

.search,
.select {
  width: 100%;
  background: rgba(51, 52, 48, 0.94);
  color: var(--text);
  border: 1px solid var(--line-strong);
  border-radius: 13px;
  padding: 12px 13px;
  outline: none;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
}

.search::placeholder {
  color: var(--muted-2);
}

.btn {
  border: 1px solid var(--line-strong);
  background: rgba(37, 38, 35, 0.92);
  color: var(--cream);
  padding: 11px 14px;
  border-radius: 13px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-weight: 750;
}

.btn:hover {
  background: rgba(255,255,255,0.055);
}

.tableCard {
  border: 1px solid var(--line);
  background: rgba(35, 36, 33, 0.76);
  border-radius: 22px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.tableWrap {
  overflow-x: auto;
}

table {
  width: 100%;
  min-width: 850px;
  border-collapse: collapse;
}

th {
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  text-align: left;
  padding: 15px 14px;
  border-bottom: 1px solid var(--line);
  background: rgba(255,255,255,0.025);
}

td {
  padding: 14px;
  border-bottom: 1px solid rgba(255,255,255,0.075);
  color: #ddd8cf;
  font-size: 13px;
  vertical-align: middle;
}

tr:last-child td {
  border-bottom: 0;
}

.productName {
  font-weight: 900;
  color: var(--text);
  letter-spacing: -0.02em;
}

.sku {
  color: var(--muted);
  font-size: 11px;
  margin-top: 3px;
}

.dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 999px;
  box-shadow: 0 0 0 4px rgba(255,255,255,0.035);
}

.dot.green {
  background: var(--green);
}

.dot.red {
  background: var(--red);
}

.dot.gray {
  background: #ada79c;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border-radius: 999px;
  padding: 5px 10px;
  font-size: 11px;
  font-weight: 900;
  white-space: nowrap;
}

.badge.red {
  background: #f7e7e4;
  color: #7c2222;
}

.badge.green {
  background: #dff4ee;
  color: #115241;
}

.badge.amber {
  background: #fff0d7;
  color: #704004;
}

.badge.gray {
  background: rgba(255,255,255,0.11);
  color: var(--cream);
}

.price {
  font-variant-numeric: tabular-nums;
  font-weight: 850;
  color: var(--cream);
}

.mrp {
  color: var(--muted);
  text-decoration: line-through;
  font-size: 12px;
}

.discount {
  color: var(--green);
  font-weight: 900;
}

.priceGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(150px, 1fr));
  gap: 10px;
}

.priceMini {
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.035);
  border-radius: 15px;
  padding: 12px;
}

.priceMiniTop {
  color: var(--muted);
  font-size: 11px;
  margin-bottom: 8px;
  font-weight: 800;
}

.priceMiniValue {
  font-size: 16px;
  font-weight: 950;
}

.priceMiniSub {
  color: var(--muted);
  font-size: 11px;
  margin-top: 3px;
}

.insightGrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 22px;
}

.insightList {
  margin: 0;
  padding-left: 20px;
  line-height: 1.75;
  color: #ded8ce;
  font-size: 13px;
}

.timeline {
  display: grid;
  gap: 10px;
}

.timelineItem {
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.035);
  border-radius: 16px;
  padding: 14px;
  display: grid;
  grid-template-columns: 140px 1fr auto;
  gap: 14px;
  align-items: center;
}

.timelineDate {
  color: var(--cream);
  font-weight: 900;
}

.timelineMeta {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.45;
}

.empty {
  color: var(--muted);
  padding: 22px;
  text-align: center;
}

.legend {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  color: var(--muted);
  font-size: 12px;
  margin-top: 13px;
}

.legend span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.footer {
  color: var(--muted);
  font-size: 12px;
  margin-top: 28px;
}

@media (max-width: 980px) {
  .hero,
  .insightGrid {
    grid-template-columns: 1fr;
  }

  .kpiGrid,
  .platformGrid,
  .priceGrid {
    grid-template-columns: 1fr 1fr;
  }

  .controls {
    grid-template-columns: 1fr;
  }

  .tabs {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .page {
    padding: 18px;
  }

  h1 {
    font-size: 31px;
  }

  .kpiGrid,
  .platformGrid,
  .priceGrid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   Brillare Mobile System Upgrade
   Mobile-only rules under 768px. Desktop configuration untouched.
   ========================================================= */

.mobileProductList {
  display: none;
}

.discountRed {
  color: #ff5f57 !important;
  font-weight: 850;
}

.priceRiskCell {
  background: rgba(224, 86, 79, 0.08);
}

.alertStack {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

@media (max-width: 767px) {
  html,
  body {
    max-width: 100%;
    overflow-x: hidden;
  }

  .page {
    width: 100%;
    max-width: 100%;
    padding: 18px 14px 44px;
    overflow-x: hidden;
  }

  .hero {
    display: grid;
    gap: 18px;
    padding-top: 8px;
  }

  .eyebrow {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    line-height: 1.4;
    opacity: 0.78;
  }

  .hero h1 {
    font-size: clamp(34px, 11vw, 48px);
    line-height: 0.94;
    letter-spacing: -0.07em;
    margin-top: 10px;
    max-width: 9ch;
  }

  .subtitle {
    font-size: 14.5px;
    line-height: 1.55;
    max-width: 34ch;
    margin-top: 14px;
  }

  .lastUpdated {
    width: 100%;
    border-radius: 24px;
    padding: 16px;
  }

  .lastUpdatedLabel {
    font-size: 10.5px;
    letter-spacing: 0.11em;
  }

  .lastUpdatedValue {
    font-size: 14px;
    line-height: 1.35;
  }

  .tabShell {
    position: sticky;
    top: 0;
    z-index: 50;
    margin-inline: -14px;
    padding: 10px 14px;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
    padding: 5px;
    border-radius: 20px;
    overflow: hidden;
  }

  .tab {
    min-height: 46px;
    padding: 8px 6px;
    border-radius: 15px;
    font-size: 11.5px;
    line-height: 1.12;
    justify-content: center;
    gap: 5px;
    white-space: normal;
    text-align: center;
  }

  .tab svg {
    width: 14px;
    height: 14px;
  }

  .kpiGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
  }

  .card {
    border-radius: 24px;
    padding: 16px;
  }

  .kpiLabel {
    font-size: 10px;
    letter-spacing: 0.09em;
  }

  .kpiValue {
    font-size: 25px;
    line-height: 1;
    margin-top: 9px;
    letter-spacing: -0.045em;
  }

  .kpiSub {
    font-size: 11.5px;
    line-height: 1.35;
    margin-top: 6px;
  }

  .section {
    margin-top: 26px;
  }

  .sectionTitle {
    display: grid;
    gap: 14px;
    margin-bottom: 14px;
  }

  .sectionTitle h2 {
    font-size: 22px;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .sectionTitle p {
    font-size: 13.5px;
    line-height: 1.45;
    max-width: 34ch;
  }

  .platformGrid {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .platformCard {
    border-radius: 22px;
    padding: 16px;
  }

  .platformName {
    font-size: 13px;
  }

  .platformNum {
    font-size: 29px;
    margin-top: 10px;
  }

  .controls {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    position: sticky;
    top: 72px;
    z-index: 40;
    padding: 10px;
    margin-inline: -4px;
    border-radius: 26px;
    background: rgba(12, 13, 18, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.26);
  }

  .search,
  .select,
  .btn {
    width: 100%;
    min-height: 48px;
    border-radius: 17px;
    font-size: 14px;
  }

  .btn {
    justify-content: center;
  }

  .tableCard {
    display: none;
  }

  .mobileProductList {
    display: grid;
    gap: 12px;
    margin-top: 14px;
  }

  .mobileProductCard,
  .mobileHistoryCard {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(circle at 0% 0%, rgba(47, 169, 113, 0.08), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.078), rgba(255, 255, 255, 0.034)),
      rgba(255, 255, 255, 0.035);
    border-radius: 28px;
    padding: 15px;
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  .mobileProductTop {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .mobileProductInfo {
    min-width: 0;
  }

  .mobileProductName {
    font-size: 15px;
    line-height: 1.25;
    font-weight: 780;
    letter-spacing: -0.024em;
    color: var(--foreground, #f7f3ea);
  }

  .mobileProductMeta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 7px;
    color: rgba(247, 243, 234, 0.56);
    font-size: 11.5px;
    line-height: 1.25;
  }

  .mobileProductMeta span {
    max-width: 100%;
    padding: 4px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.055);
  }

  .mobileStatusPill {
    flex-shrink: 0;
    border-radius: 999px;
    padding: 7px 10px;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mobileStatusPill.healthy,
  .mobileStatusPill.green {
    color: #50d48d;
    background: rgba(47, 169, 113, 0.14);
  }

  .mobileStatusPill.warning,
  .mobileStatusPill.amber {
    color: #f2b84b;
    background: rgba(217, 150, 42, 0.16);
  }

  .mobileStatusPill.critical,
  .mobileStatusPill.red {
    color: #ff746d;
    background: rgba(224, 86, 79, 0.18);
  }

  .mobileStatusPill.neutral,
  .mobileStatusPill.gray {
    color: rgba(247, 243, 234, 0.68);
    background: rgba(255, 255, 255, 0.075);
  }

  .mobileHealthRow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 14px;
  }

  .mobileHealthRow > div {
    border-radius: 19px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.055);
  }

  .mobileHealthValue {
    font-size: 23px;
    font-weight: 850;
    letter-spacing: -0.045em;
  }

  .mobileHealthLabel {
    color: rgba(247, 243, 234, 0.58);
    font-size: 12px;
  }

  .mobilePlatformGrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin-top: 14px;
  }

  .mobilePlatformCell {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 46px;
    padding: 11px 12px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.045);
  }

  .mobilePlatformCell.discountRisk,
  .mobilePriceRisk {
    background: rgba(224, 86, 79, 0.14) !important;
    box-shadow: inset 0 0 0 1px rgba(224, 86, 79, 0.18);
  }

  .mobilePlatformLabel {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    font-size: 13px;
    font-weight: 680;
    color: rgba(247, 243, 234, 0.9);
  }

  .mobilePlatformStatus {
    color: rgba(247, 243, 234, 0.58);
    font-size: 12px;
    text-align: right;
  }

  .mobilePlatformStatus strong {
    color: #ff746d;
    font-weight: 850;
  }

  .mobilePlatformPrice {
    font-size: 13.5px;
    font-weight: 850;
    text-align: right;
  }

  .mobilePlatformMrp {
    color: rgba(247, 243, 234, 0.45);
    font-size: 11px;
    text-decoration: line-through;
    text-align: right;
    margin-top: 2px;
  }

  .mobilePlatformDiscount {
    color: #f2b84b;
    font-size: 11px;
    font-weight: 800;
    text-align: right;
    margin-top: 2px;
  }

  .mobilePlatformDiscount.discountRed {
    color: #ff746d !important;
  }

  .mobilePriceHero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 14px;
  }

  .mobilePriceHero.three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .mobilePriceHero > div {
    border-radius: 19px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.055);
  }

  .mobilePriceLabel {
    color: rgba(247, 243, 234, 0.5);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 850;
  }

  .mobilePriceValue {
    margin-top: 7px;
    font-size: 20px;
    line-height: 1;
    font-weight: 880;
    letter-spacing: -0.05em;
  }

  .mobilePriceSource {
    margin-top: 6px;
    color: rgba(247, 243, 234, 0.52);
    font-size: 11.5px;
  }

  .mobileTimestamp {
    margin-top: 12px;
    color: rgba(247, 243, 234, 0.48);
    font-size: 11.5px;
  }

  .insightGrid {
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 22px;
  }

  .cardHeader {
    align-items: flex-start;
    gap: 12px;
  }

  .cardTitle {
    font-size: 16px;
  }

